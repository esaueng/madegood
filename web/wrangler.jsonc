// Cloudflare Worker serving the website (static assets) and the API under /api.
//
// Resource IDs below are placeholders. Never commit real account or resource IDs:
// self-hosters and maintainers set them up as described in docs/self-hosting.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madegood",
  "main": "./src/server/index.ts",
  // Production serves only its custom domain (CANONICAL_ORIGIN); the workers.dev address is off.
  // Preview versions keep their *-madegood.<subdomain>.workers.dev URLs.
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API routes always reach the Worker, never the SPA fallback. /s/* and /u/* get Open
    // Graph tags injected into the SPA shell (src/server/routes/session-preview.ts).
    "run_worker_first": ["/api/*", "/v/*", "/s/*", "/u/*"]
  },
  // APPLE_AUDIENCES: comma-separated Sign in with Apple audiences for the app's
  // POST /api/auth/apple (the iOS bundle ID only — never add the web Services ID here, or
  // web identity tokens would be accepted without the web flow's state and nonce checks).
  // APPLE_WEB_CLIENT_ID: the Services ID for Sign in with Apple on the website; empty turns
  // web sign-in off. Secrets such as JWT_SIGNING_KEY are not
  // listed here.
  // Production web sign-in uses the Services ID app.madegood.web (return URL
  // https://<production host>/api/auth/web/apple/callback). Previews stay off: their
  // per-PR hosts aren't registered return URLs.
  // CANONICAL_ORIGIN: the one public address. Pages (and the SPA, via
  // VITE_CANONICAL_ORIGIN at build time) on any other host move there; /api answers on all.
  "vars": {
    "APP_VERSION": "0.1.0",
    "APPLE_AUDIENCES": "app.madegood",
    "APPLE_WEB_CLIENT_ID": "app.madegood.web",
    "CANONICAL_ORIGIN": "https://madegood.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madegood",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VOYAGE_LIVE", "class_name": "VoyageLive" }]
  },
  "migrations": [{ "tag": "voyage-live-v1", "new_sqlite_classes": ["VoyageLive"] }],
  "r2_buckets": [{ "binding": "TRACKS", "bucket_name": "madegood-tracks" }],
  // Local namespace placeholders. scripts/cloudflare-config assigns deployment namespaces.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "SESSION_UPLOAD_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  // Upload post-processing (src/server/lib/postprocess.ts, docs/self-hosting.md). A message
  // that fails max_retries times lands in the dead-letter queue, which has no consumer:
  // inspect or replay it from the dashboard.
  "queues": {
    "producers": [
      { "binding": "POSTPROCESS", "queue": "madegood-postprocess" },
      // Account exports (src/server/lib/export-job.ts): one ZIP part per message.
      { "binding": "EXPORTS", "queue": "madegood-exports" }
    ],
    "consumers": [
      {
        "queue": "madegood-postprocess",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "madegood-postprocess-dlq"
      },
      {
        // One part per invocation keeps each step inside a Worker's subrequest and CPU
        // limits. No dead-letter queue: the scheduled sweep resumes or fails a stuck job.
        "queue": "madegood-exports",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  // Sweep for privacy zone changes whose reprocessing could not be queued (postprocess.ts),
  // and for account exports to expire, resume or fail (export-job.ts).
  "triggers": { "crons": ["*/30 * * * *"] },
  "env": {
    // Per-PR previews use their own database and bucket, never production data.
    "preview": {
      "workers_dev": true,
      "name": "madegood-preview",
      "vars": {
        "APP_VERSION": "0.1.0-preview",
        "APPLE_AUDIENCES": "app.madegood",
        "APPLE_WEB_CLIENT_ID": "",
        "CANONICAL_ORIGIN": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "madegood-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      // Sharing is disabled here. Preview version uploads cannot apply Durable Object migrations.
      "durable_objects": { "bindings": [] },
      "migrations": [],
      "r2_buckets": [{ "binding": "TRACKS", "bucket_name": "madegood-tracks-preview" }],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "SESSION_UPLOAD_RATE_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 1200, "period": 60 }
        }
      ],
      // No queue: preview version uploads cannot set queue consumers. Without the binding
      // the Worker post-processes each upload after responding (waitUntil, one attempt).
      "queues": {},
      "triggers": { "crons": [] }
    }
  }
}
