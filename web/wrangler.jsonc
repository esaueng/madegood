// Cloudflare Worker serving the website (static assets) and the API under /api.
//
// Resource IDs below are placeholders. Never commit real account or resource IDs:
// self-hosters and maintainers set them up as described in docs/self-hosting.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madegood",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // API routes always reach the Worker, never the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  // APPLE_AUDIENCES: comma-separated Sign in with Apple audiences (the iOS bundle ID; the
  // web Services ID joins later). Secrets such as JWT_SIGNING_KEY are not listed here.
  "vars": { "APP_VERSION": "0.1.0", "APPLE_AUDIENCES": "app.madegood" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madegood",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "TRACKS", "bucket_name": "madegood-tracks" }],
  "env": {
    // Per-PR previews use their own database and bucket, never production data.
    "preview": {
      "name": "madegood-preview",
      "vars": { "APP_VERSION": "0.1.0-preview", "APPLE_AUDIENCES": "app.madegood" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "madegood-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "TRACKS", "bucket_name": "madegood-tracks-preview" }]
    }
  }
}
