{
  "openapi": "3.1.0",
  "info": {
    "title": "MadeGood API",
    "version": "1"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from POST /auth/apple or POST /auth/refresh."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "db"
        ]
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for the API; expires in 15 minutes."
          },
          "refreshToken": {
            "type": "string",
            "description": "Single-use token for POST /auth/refresh; expires in 60 days."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string",
            "example": "skipper_4821"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "units": {
            "type": "string",
            "enum": [
              "metric",
              "imperial",
              "nautical"
            ]
          },
          "defaultVisibility": {
            "type": "string",
            "enum": [
              "private",
              "unlisted",
              "public"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "handle",
          "displayName",
          "units",
          "defaultVisibility",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "invalid_identity_token",
              "invalid_refresh_token",
              "refresh_token_reused",
              "handle_taken",
              "not_found",
              "internal"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "AppleSignInRequest": {
        "type": "object",
        "properties": {
          "identityToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "displayName": {
            "type": "string",
            "maxLength": 200,
            "description": "The name Apple shares on the first authorization."
          }
        },
        "required": [
          "identityToken"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for the API; expires in 15 minutes."
          },
          "refreshToken": {
            "type": "string",
            "description": "Single-use token for POST /auth/refresh; expires in 60 days."
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50,
            "description": "Blank or null clears it."
          },
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,30}$",
            "description": "Stored lowercase; uppercase input is lowercased."
          },
          "units": {
            "type": "string",
            "enum": [
              "metric",
              "imperial",
              "nautical"
            ]
          },
          "defaultVisibility": {
            "type": "string",
            "enum": [
              "private",
              "unlisted",
              "public"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "The API and its database are reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/auth/apple": {
      "post": {
        "summary": "Sign in with Apple",
        "description": "Exchanges a Sign in with Apple identity token for API tokens, creating the account on first sign-in.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleSignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The identity token is invalid, expired or for another app.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate a refresh token",
        "description": "Exchanges a refresh token for a new access and refresh token. Each refresh token works once; reusing one signs the user out everywhere.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new token pair.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The refresh token is invalid, expired, or was already used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "The signed-in user",
        "tags": [
          "account"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token, or the account no longer exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update the signed-in user's profile and settings",
        "tags": [
          "account"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token, or the account no longer exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The handle is taken or reserved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete the signed-in user's account and all their data",
        "description": "Deletes the user's track files and every database row that belongs to them. Repeating the request with the same access token succeeds.",
        "tags": [
          "account"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "The account and its data are gone."
          },
          "401": {
            "description": "Missing or invalid access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
