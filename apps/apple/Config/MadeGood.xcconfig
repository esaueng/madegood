// Shared build settings for every target and configuration.
// Do not put a team ID here: copy Local.xcconfig.example to Local.xcconfig.

BUNDLE_ID_PREFIX = app.madegood
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// TestFlight builds keep the major.minor and replace the patch with the commit count
// (scripts/testflight), so only change this to start a new minor or major version.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// SWIFT_VERSION (6.0) is set in Project.swift; see the comment there.
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// Optional, gitignored overrides (team ID, bundle prefix for forks).
#include? "Local.xcconfig"
