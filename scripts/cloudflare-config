#!/usr/bin/env python3
"""Fill the real D1 database IDs into web/wrangler.jsonc for a deploy.

The repository keeps placeholder IDs (AGENTS.md: no account or resource IDs in the
repo). Deploys run this first, in CI or a throwaway checkout, with the IDs from the
environment:

  D1_DATABASE_ID          production database (`madegood`)
  D1_PREVIEW_DATABASE_ID  preview database (`madegood-preview`)

The account comes from CLOUDFLARE_ACCOUNT_ID, which Wrangler reads itself.
Never commit the rewritten file.
"""
import os
import re
import sys
from pathlib import Path

PLACEHOLDERS = {
    "00000000-0000-0000-0000-000000000000": "D1_DATABASE_ID",
    "00000000-0000-0000-0000-000000000001": "D1_PREVIEW_DATABASE_ID",
}
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def main() -> int:
    path = Path(sys.argv[1] if len(sys.argv) > 1 else "web/wrangler.jsonc")
    text = path.read_text(encoding="utf-8")
    for placeholder, variable in PLACEHOLDERS.items():
        value = os.environ.get(variable, "").strip()
        if not UUID.fullmatch(value):
            print(f"{variable} is missing or not a database UUID", file=sys.stderr)
            return 1
        if placeholder not in text:
            print(f"Placeholder for {variable} not found in {path}", file=sys.stderr)
            return 1
        text = text.replace(placeholder, value)
    path.write_text(text, encoding="utf-8")
    print(f"Filled database IDs into {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
